{
  "onebot": {
    "ws_url": "ws://127.0.0.1:3001/",
    "access_token": "填 SnowLuma config/onebot_<机器人QQ号>.json 中 networks.wsServers[0].accessToken",
    "self_id": 0,
    "connect_timeout": 10,
    "action_timeout": 15,
    "reconnect_min_delay": 1,
    "reconnect_max_delay": 30
  },
  "bot": {
    "owner_qq": 0,
    "allowed_private_senders": [0],
    "reply_mode": "fixed",
    "fixed_reply_text": "收到，QQ 链路已连通。",
    "dedup_cache_size": 2048,
    "max_handlers": 4,
    "event_queue_size": 1000,
    "data_dir": null,
    "log_level": "INFO"
  },
  "deepseek": {
    "base_url": "https://api.deepseek.com",
    "model": "deepseek-flash",
    "timeout": 60,
    "max_tokens": 1024,
    "max_input_tokens": 8000,
    "max_history_messages": 20,
    "max_history_tokens": 2000,
    "max_reply_chars": 3000,
    "model_concurrency": 4,
    "memory_context_items": 8,
    "enable_thinking": false,
    "system_prompt": "你是一个友好的 QQ 私聊机器人助手，用简洁的中文回答。"
  },
  "plugins": {
    "extra_roots": [],
    "instances": {
      "builtin.hello": {"enabled": true, "config": {}},
      "builtin.counter": {"enabled": true, "config": {}},
      "builtin.ego_browser": {"enabled": false, "config": {}}
    }
  },
  "tools": {
    "enable": true,
    "max_model_rounds": 5,
    "max_tool_calls": 8,
    "tool_timeout": 60,
    "task_timeout": 300,
    "max_tool_result_chars": 6000,
    "accept_notice": true
  }
}
