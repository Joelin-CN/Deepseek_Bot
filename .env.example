# Copy this file to .env and fill in values locally. .env is git-ignored.
# Never put a QQ password or login session in this file.

# Required when bot.reply_mode=deepseek (get one at https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# Reserved for future use; the OneBot token currently lives in config/local.json.
ONEBOT_ACCESS_TOKEN=
COMPANION_ADMIN_TOKEN=
COMPANION_DATA_DIR=

# SnowLuma WebUI bootstrap password (>=8 chars, local only).
# Used by scripts\windows\start_snowluma.ps1 -> SNOWLUMA_WEBUI_BOOTSTRAP_PASSWORD.
# Takes effect only when E:\Softwares\SnowLuma\config\webui.json is absent
# (e.g. fresh install or after moving the old file away; it is then seeded
# from this value and will not be rotated). Keep out of Git.
SNOWLUMA_WEBUI_PASSWORD=
