# Copy this file to .env and fill in values locally. .env is git-ignored.
# Never put a QQ password or login session in this file.

# Required when bot.reply_mode=deepseek (get one at https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# Reserved for future use; the OneBot token currently lives in config/local.json.
ONEBOT_ACCESS_TOKEN=
COMPANION_ADMIN_TOKEN=
COMPANION_DATA_DIR=
